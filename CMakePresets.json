{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "vcpkg",
      "hidden": true,
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/ports"
      }
    },
    {
      "name": "static",
      "hidden": true,
      "cacheVariables": {
        "UT_STATIC_LINK": "ON"
      }
    },
    {
      "name": "win32",
      "inherits": ["base", "vcpkg"],
      "generator": "Visual Studio 17 2022",
      "architecture": "Win32",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x86-windows-static-md"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "win64",
      "inherits": "win32",
      "architecture": "x64",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      }
    },
    {
      "name": "linux64",
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux32",
      "inherits": "linux64",
      "toolchainFile": "${sourceDir}/Tools/linux-i686.cmake"
    },
    {
      "name": "tidy",
      "inherits": "linux64",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CONFIGURATION_TYPES": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "android-arm64",
      "inherits": ["base", "vcpkg", "static"],
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "VCPKG_TARGET_TRIPLET": "arm64-android",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-28",
        "ANDROID_STL": "c++_shared"
      }
    },
    {
      "name": "web",
      "inherits": ["base", "vcpkg", "static"],
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
        "VCPKG_TARGET_TRIPLET": "wasm32-emscripten"
      }
    },
    { "name": "win32-static", "inherits": ["static", "win32"] },
    { "name": "win64-static", "inherits": ["static", "win64"] },
    { "name": "linux64-static", "inherits": ["static", "linux64"] },
    { "name": "linux32-static", "inherits": ["static", "linux32"] }
  ],
  "buildPresets": [
    { "name": "debug", "hidden": true, "configuration": "Debug" },
    { "name": "release", "hidden": true, "configuration": "Release" },
    { "name": "win32-debug", "inherits": "debug", "configurePreset": "win32" },
    { "name": "win32-release", "inherits": "release", "configurePreset": "win32" },
    { "name": "win64-debug", "inherits": "debug", "configurePreset": "win64" },
    { "name": "win64-release", "inherits": "release", "configurePreset": "win64" },
    { "name": "linux64-debug", "inherits": "debug", "configurePreset": "linux64" },
    { "name": "linux64-release", "inherits": "release", "configurePreset": "linux64" },
    { "name": "linux32-debug", "inherits": "debug", "configurePreset": "linux32" },
    { "name": "linux32-release", "inherits": "release", "configurePreset": "linux32" },
    { "name": "android-arm64-release", "configurePreset": "android-arm64", "targets": ["ut_apk"] },
    { "name": "web-release", "configurePreset": "web", "targets": ["ut_web"] },
    { "name": "win32-static-debug", "inherits": "debug", "configurePreset": "win32-static" },
    { "name": "win32-static-release", "inherits": "release", "configurePreset": "win32-static" },
    { "name": "win64-static-debug", "inherits": "debug", "configurePreset": "win64-static" },
    { "name": "win64-static-release", "inherits": "release", "configurePreset": "win64-static" },
    { "name": "linux64-static-debug", "inherits": "debug", "configurePreset": "linux64-static" },
    { "name": "linux64-static-release", "inherits": "release", "configurePreset": "linux64-static" },
    { "name": "linux32-static-debug", "inherits": "debug", "configurePreset": "linux32-static" },
    { "name": "linux32-static-release", "inherits": "release", "configurePreset": "linux32-static" }
  ],
  "testPresets": [
    {
      "name": "test",
      "hidden": true,
      "configuration": "Release",
      "output": { "outputOnFailure": true },
      "execution": { "timeout": 600 }
    },
    { "name": "win64", "inherits": "test", "configurePreset": "win64" },
    { "name": "linux64", "inherits": "test", "configurePreset": "linux64" }
  ],
  "packagePresets": [
    { "name": "win64", "configurePreset": "win64", "generators": ["ZIP"], "configurations": ["Release"] },
    { "name": "linux64", "configurePreset": "linux64", "generators": ["TGZ"], "configurations": ["Release"] }
  ]
}
