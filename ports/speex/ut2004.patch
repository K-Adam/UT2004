+
+#ifdef FIXED_POINT
+#error "The 4.8 kbps mode is float only"
+#endif
+
+#include <math.h>
+#include "speex/speex.h"
+#include "speex/speex_bits.h"
+#include "arch.h"
+#include "os_support.h"
+#include "stack_alloc.h"
+#include "filters.h"
+#include "lpc.h"
+#include "lsp.h"
+#include "ltp.h"
+#include "cb_search.h"
+#include "quant_lsp.h"
+
+#ifndef M_PI
+#define M_PI 3.14159265358979323846
+#endif
+
+#define FRAME_SIZE      240
+#define SUBFRAME_SIZE   48
+#define NB_SUBFRAMES    5
+#define ORDER           10
+#define WINDOW_SIZE     (FRAME_SIZE*3/2)
+#define BUF_SIZE        640
+#define PITCH_START     17
+#define PITCH_END       144
+#define BITS_PER_FRAME  144
+#define GAMMA1          0.9f
+#define GAMMA2          0.6f
+#define LAG_FACTOR      .01f
+#define LPC_FLOOR       1.0003f
+#define LSP_MARGIN      .002f
+#define COMB_GAIN       .55f
+#define PLC_TUNING      2
+#define COMPLEXITY      2
+#define ENC_HISTORY     (PITCH_END+2)
+/* The enhancer runs one sub-frame late and reaches back two pitch periods */
+#define DEC_HISTORY     (2*PITCH_END+SUBFRAME_SIZE+12)
+
+extern const signed char gain_cdbk_ulbr[];
+extern const signed char exc_12_32_table[];
+extern const signed char cdbk_lsp_vlbr[];
+extern const signed char cdbk_lsp2_vlbr[];
+
+static const ltp_params ltp_params_48k = {
+   gain_cdbk_ulbr,
+   3,               /*gain_bits*/
+   0                /*pitch_bits*/
+};
+
+static const split_cb_params split_cb_nb_48k = {
+   12,              /*subvect_size*/
+   4,               /*nb_subvect*/
+   exc_12_32_table, /*shape_cb*/
+   5,               /*shape_bits*/
+   0,               /*have_sign*/
+};
+
+typedef struct Enc48State {
+   const SpeexMode *mode;
+   int first;
+   float inBuf[BUF_SIZE];
+   float excBuf[ENC_HISTORY+FRAME_SIZE];
+   float swBuf[ENC_HISTORY+FRAME_SIZE];
+   float window[WINDOW_SIZE];
+   float lagWindow[ORDER+1];
+   float old_lsp[ORDER];
+   float old_qlsp[ORDER];
+   float mem_sp[ORDER];
+   float mem_sw[ORDER];
+   float mem_sw_whole[ORDER];
+   float mem_exc[ORDER];
+} Enc48State;
+
+typedef struct Dec48State {
+   const SpeexMode *mode;
+   int first;
+   int enh_enabled;
+   spx_uint32_t seed;
+   float excBuf[DEC_HISTORY+FRAME_SIZE];
+   float old_qlsp[ORDER];
+   float interp_qlpc[ORDER];
+   float mem_sp[ORDER];
+} Dec48State;
+
+static void lsp_quant_48k(const float *lsp, float *qlsp, SpeexBits *bits)
+{
+   int i;
+   float weight[ORDER];
+
+   for (i=0;i<ORDER;i++)
+      qlsp[i]=lsp[i];
+
+   weight[0] = 1/(qlsp[1]-qlsp[0]);
+   weight[ORDER-1] = 1/(qlsp[ORDER-1]-qlsp[ORDER-2]);
+   for (i=1;i<ORDER-1;i++)
+   {
+      float tmp1 = 1/((.15f+qlsp[i]-qlsp[i-1])*(.15f+qlsp[i]-qlsp[i-1]));
+      float tmp2 = 1/((.15f+qlsp[i+1]-qlsp[i])*(.15f+qlsp[i+1]-qlsp[i]));
+      weight[i] = tmp1 > tmp2 ? tmp1 : tmp2;
+   }
+
+   for (i=0;i<ORDER;i++)
+      qlsp[i]=256*(qlsp[i]-(.25f*i+.3125f));
+   speex_bits_pack(bits, lsp_quant(qlsp, cdbk_lsp_vlbr, 512, ORDER), 9);
+
+   for (i=0;i<ORDER;i++)
+      qlsp[i]*=4;
+   speex_bits_pack(bits, lsp_weight_quant(qlsp, weight, cdbk_lsp2_vlbr, 16, ORDER), 4);
+
+   for (i=0;i<ORDER;i++)
+      qlsp[i]=lsp[i]-0.00097655f*qlsp[i];
+}
+
+static void lsp_unquant_48k(float *lsp, SpeexBits *bits)
+{
+   int i, id;
+   for (i=0;i<ORDER;i++)
+      lsp[i]=.25f*i+.3125f;
+
+   id=speex_bits_unpack_unsigned(bits, 9);
+   for (i=0;i<ORDER;i++)
+      lsp[i] += 0.0039062f*cdbk_lsp_vlbr[id*ORDER+i];
+
+   id=speex_bits_unpack_unsigned(bits, 4);
+   for (i=0;i<ORDER;i++)
+      lsp[i] += 0.00097655f*cdbk_lsp2_vlbr[id*ORDER+i];
+}
+
+static void enc48_reset(Enc48State *st)
+{
+   int i;
+   const SpeexMode *mode = st->mode;
+   int part1 = FRAME_SIZE - (SUBFRAME_SIZE>>1);
+   int part2 = (FRAME_SIZE>>1) + (SUBFRAME_SIZE>>1);
+
+   SPEEX_MEMSET(st, 0, 1);
+   st->mode = mode;
+   st->first = 1;
+
+   /* Asymmetric "pseudo-Hamming" window */
+   for (i=0;i<part1;i++)
+      st->window[i]=.54-.46*cos(M_PI*i/part1);
+   for (i=0;i<part2;i++)
+      st->window[part1+i]=.54+.46*cos(M_PI*i/part2);
+   for (i=0;i<ORDER+1;i++)
+      st->lagWindow[i]=exp(-.5*(2*M_PI*LAG_FACTOR*i)*(2*M_PI*LAG_FACTOR*i));
+   for (i=0;i<ORDER;i++)
+      st->old_lsp[i]=M_PI*(i+1)/(ORDER+1);
+}
+
+static void *enc48_init(const SpeexMode *m)
+{
+   Enc48State *st = (Enc48State*)speex_alloc(sizeof(Enc48State));
+   if (!st)
+      return NULL;
+   st->mode = m;
+   enc48_reset(st);
+   return st;
+}
+
+static void enc48_destroy(void *state)
+{
+   speex_free(state);
+}
+
+static int enc48_encode(void *state, void *vin, SpeexBits *bits)
+{
+   Enc48State *st = (Enc48State*)state;
+   const float *in = (const float*)vin;
+   char *stack = NULL;
+   float *frame = st->inBuf + BUF_SIZE - WINDOW_SIZE;
+   float *exc = st->excBuf + ENC_HISTORY;
+   float *sw = st->swBuf + ENC_HISTORY;
+   float w_sig[WINDOW_SIZE], autocorr[ORDER+1];
+   float lpc[ORDER], lsp[ORDER], qlsp[ORDER];
+   float interp_lsp[ORDER], interp_qlsp[ORDER], interp_lpc[ORDER], interp_qlpc[ORDER];
+   float bw_lpc1[ORDER], bw_lpc2[ORDER], mem[ORDER];
+   float target[SUBFRAME_SIZE], res[SUBFRAME_SIZE], syn_resp[SUBFRAME_SIZE];
+   float innov[SUBFRAME_SIZE], exc32[SUBFRAME_SIZE];
+   int nol_pitch[6];
+   float nol_pitch_coef[6];
+   int pitch_half[2];
+   int i, sub, roots, ol_pitch, ol_pitch_id;
+   float ol_pitch_coef, ol_gain;
+
+   SPEEX_MOVE(st->inBuf, st->inBuf+FRAME_SIZE, BUF_SIZE-FRAME_SIZE);
+   SPEEX_COPY(st->inBuf+BUF_SIZE-FRAME_SIZE, in, FRAME_SIZE);
+   SPEEX_MOVE(st->excBuf, st->excBuf+FRAME_SIZE, ENC_HISTORY);
+   SPEEX_MOVE(st->swBuf, st->swBuf+FRAME_SIZE, ENC_HISTORY);
+
+   for (i=0;i<WINDOW_SIZE;i++)
+      w_sig[i] = frame[i]*st->window[i];
+   _spx_autocorr(w_sig, autocorr, ORDER+1, WINDOW_SIZE);
+   autocorr[0] *= LPC_FLOOR;
+   for (i=0;i<ORDER+1;i++)
+      autocorr[i] *= st->lagWindow[i];
+   _spx_lpc(lpc, autocorr, ORDER);
+
+   roots = lpc_to_lsp(lpc, ORDER, lsp, 15, 0.2f, stack);
+   if (roots!=ORDER)
+      roots = lpc_to_lsp(lpc, ORDER, lsp, 11, 0.05f, stack);
+   if (roots!=ORDER)
+      SPEEX_COPY(lsp, st->old_lsp, ORDER);
+
+   /* Whole-frame open-loop pitch and excitation gain */
+   if (st->first)
+      SPEEX_COPY(interp_lsp, lsp, ORDER);
+   else
+      lsp_interpolate(st->old_lsp, lsp, interp_lsp, ORDER, 4, 8, LSP_MARGIN);
+   lsp_to_lpc(interp_lsp, interp_lpc, ORDER, stack);
+
+   bw_lpc(GAMMA1, interp_lpc, bw_lpc1, ORDER);
+   bw_lpc(GAMMA2, interp_lpc, bw_lpc2, ORDER);
+   filter_mem16(frame, bw_lpc1, bw_lpc2, sw, FRAME_SIZE, ORDER, st->mem_sw_whole, stack);
+
+   open_loop_nbest_pitch(sw, PITCH_START, PITCH_END, FRAME_SIZE, nol_pitch, nol_pitch_coef, 6, stack);
+   ol_pitch = nol_pitch[0];
+   ol_pitch_coef = nol_pitch_coef[0];
+   for (i=1;i<6;i++)
+   {
+      if (nol_pitch_coef[i]>.85*ol_pitch_coef &&
+          (fabs(nol_pitch[i]-ol_pitch/2.0)<=1 || fabs(nol_pitch[i]-ol_pitch/3.0)<=1 ||
+           fabs(nol_pitch[i]-ol_pitch/4.0)<=1 || fabs(nol_pitch[i]-ol_pitch/5.0)<=1))
+         ol_pitch = nol_pitch[i];
+   }
+   if (ol_pitch < PITCH_START+2)
+      ol_pitch = PITCH_START+2;
+   if (ol_pitch > PITCH_END-2)
+      ol_pitch = PITCH_END-2;
+   open_loop_nbest_pitch(sw, ol_pitch-2, ol_pitch+2, FRAME_SIZE>>1, &pitch_half[0], nol_pitch_coef, 1, stack);
+   open_loop_nbest_pitch(sw+(FRAME_SIZE>>1), pitch_half[0]-1, pitch_half[0]+2, FRAME_SIZE>>1, &pitch_half[1], nol_pitch_coef, 1, stack);
+
+   fir_mem16(frame, interp_lpc, exc, FRAME_SIZE, ORDER, st->mem_exc, stack);
+   {
+      float ol1=0, ol2=0;
+      for (i=0;i<FRAME_SIZE>>1;i++)
+         ol1 += exc[i]*exc[i];
+      for (;i<FRAME_SIZE;i++)
+         ol2 += exc[i]*exc[i];
+      ol_gain = ol2>ol1 ? ol2 : ol1;
+      ol_gain = sqrt(2*ol_gain*(ol1+ol2))*1.3*(1-.5*ol_pitch_coef*ol_pitch_coef);
+      ol_gain = sqrt(1+ol_gain/FRAME_SIZE);
+   }
+
+   if (st->first)
+      SPEEX_COPY(st->old_lsp, lsp, ORDER);
+
+   lsp_quant_48k(lsp, qlsp, bits);
+   speex_bits_pack(bits, pitch_half[0]-PITCH_START, 7);
+   speex_bits_pack(bits, pitch_half[1]-pitch_half[0]+1, 2);
+   {
+      int quant = (int)floor(.5+7.4*ol_pitch_coef);
+      if (quant>7)
+         quant=7;
+      if (quant<0)
+         quant=0;
+      ol_pitch_id=quant;
+      speex_bits_pack(bits, quant, 3);
+      ol_pitch_coef=0.13514*quant;
+   }
+   {
+      int qe = (int)floor(.5+2.1*log(ol_gain))-2;
+      if (qe<0)
+         qe=0;
+      if (qe>15)
+         qe=15;
+      ol_gain = exp((qe+2)/2.1);
+      speex_bits_pack(bits, qe, 4);
+   }
+
+   if (st->first)
+      SPEEX_COPY(st->old_qlsp, qlsp, ORDER);
+
+   for (sub=0;sub<NB_SUBFRAMES;sub++)
+   {
+      int offset = SUBFRAME_SIZE*sub;
+      float *sp = frame+offset;
+      float *e = exc+offset;
+      float *w = sw+offset;
+      int pit_min, pit_max;
+      /* Reset every sub-frame, so the pitch gain limiter never engages, as in the original mode */
+      spx_word32_t cumul_gain = 1024;
+
+      ol_pitch = sub*2 < NB_SUBFRAMES ? pitch_half[0] : pitch_half[1];
+
+      lsp_interpolate(st->old_lsp, lsp, interp_lsp, ORDER, sub, NB_SUBFRAMES, LSP_MARGIN);
+      lsp_interpolate(st->old_qlsp, qlsp, interp_qlsp, ORDER, sub, NB_SUBFRAMES, LSP_MARGIN);
+      lsp_to_lpc(interp_lsp, interp_lpc, ORDER, stack);
+      lsp_to_lpc(interp_qlsp, interp_qlpc, ORDER, stack);
+      bw_lpc(GAMMA1, interp_lpc, bw_lpc1, ORDER);
+      bw_lpc(GAMMA2, interp_lpc, bw_lpc2, ORDER);
+
+      compute_impulse_response(interp_qlpc, bw_lpc1, bw_lpc2, syn_resp, SUBFRAME_SIZE, ORDER, stack);
+
+      /* Target is the weighted input minus the zero-input response of A(z/g1)/(A(z)A(z/g2)) */
+      SPEEX_MEMSET(e, 0, SUBFRAME_SIZE);
+      SPEEX_COPY(mem, st->mem_sp, ORDER);
+      iir_mem16(e, interp_qlpc, e, SUBFRAME_SIZE, ORDER, mem, stack);
+      SPEEX_COPY(mem, st->mem_sw, ORDER);
+      filter_mem16(e, bw_lpc1, bw_lpc2, res, SUBFRAME_SIZE, ORDER, mem, stack);
+      SPEEX_COPY(mem, st->mem_sw, ORDER);
+      filter_mem16(sp, bw_lpc1, bw_lpc2, w, SUBFRAME_SIZE, ORDER, mem, stack);
+      for (i=0;i<SUBFRAME_SIZE;i++)
+         target[i]=w[i]-res[i];
+      SPEEX_MEMSET(e, 0, SUBFRAME_SIZE);
+
+      pit_min = pit_max = ol_pitch;
+      /* The first frame has no past excitation to predict from */
+      if (st->first && pit_max>offset)
+         pit_max=offset;
+      /* Also removes the adaptive codebook contribution from target */
+      pitch_search_3tap(target, w, interp_qlpc, bw_lpc1, bw_lpc2, exc32, &ltp_params_48k,
+                        pit_min, pit_max, ol_pitch_coef, ORDER, SUBFRAME_SIZE, bits, stack,
+                        e, syn_resp, COMPLEXITY, ol_pitch_id, PLC_TUNING, &cumul_gain);
+
+      for (i=0;i<SUBFRAME_SIZE;i++)
+         target[i]/=ol_gain;
+      SPEEX_MEMSET(innov, 0, SUBFRAME_SIZE);
+      split_cb_search_shape_sign(target, interp_qlpc, bw_lpc1, bw_lpc2, &split_cb_nb_48k, ORDER,
+                                 SUBFRAME_SIZE, innov, syn_resp, bits, stack, COMPLEXITY, 0);
+      for (i=0;i<SUBFRAME_SIZE;i++)
+         e[i]=exc32[i]+ol_gain*innov[i];
+
+      /* The coded frame is never analysed again, so the synthesis can replace it */
+      iir_mem16(e, interp_qlpc, sp, SUBFRAME_SIZE, ORDER, st->mem_sp, stack);
+      filter_mem16(sp, bw_lpc1, bw_lpc2, w, SUBFRAME_SIZE, ORDER, st->mem_sw, stack);
+   }
+
+   SPEEX_COPY(st->old_lsp, lsp, ORDER);
+   SPEEX_COPY(st->old_qlsp, qlsp, ORDER);
+   st->first = 0;
+   return 1;
+}
+
+static int enc48_ctl(void *state, int request, void *ptr)
+{
+   Enc48State *st = (Enc48State*)state;
+   switch (request)
+   {
+   case SPEEX_GET_FRAME_SIZE:
+      *(spx_int32_t*)ptr = FRAME_SIZE;
+      break;
+   /* There is a single rate, so rate requests are accepted as is */
+   case SPEEX_SET_BITRATE:
+   case SPEEX_SET_SAMPLING_RATE:
+      break;
+   case SPEEX_RESET_STATE:
+      enc48_reset(st);
+      break;
+   default:
+      speex_warning_int("Unknown nb_ctl request: ", request);
+      return -1;
+   }
+   return 0;
+}
+
+static void dec48_reset(Dec48State *st)
+{
+   int i;
+   const SpeexMode *mode = st->mode;
+   int enh = st->enh_enabled;
+
+   SPEEX_MEMSET(st, 0, 1);
+   st->mode = mode;
+   st->enh_enabled = enh;
+   st->first = 1;
+   st->seed = 1000;
+   for (i=0;i<ORDER;i++)
+      st->old_qlsp[i]=M_PI*(i+1)/(ORDER+1);
+}
+
+static void *dec48_init(const SpeexMode *m)
+{
+   Dec48State *st = (Dec48State*)speex_alloc(sizeof(Dec48State));
+   if (!st)
+      return NULL;
+   st->mode = m;
+   st->enh_enabled = 1;
+   dec48_reset(st);
+   return st;
+}
+
+static void dec48_destroy(void *state)
+{
+   speex_free(state);
+}
+
+static int dec48_decode(void *state, SpeexBits *bits, void *vout)
+{
+   Dec48State *st = (Dec48State*)state;
+   float *out = (float*)vout;
+   char *stack = NULL;
+   float *exc = st->excBuf + DEC_HISTORY;
+   float qlsp[ORDER], interp_qlsp[ORDER], ak[ORDER];
+   float innov[SUBFRAME_SIZE], exc32[SUBFRAME_SIZE];
+   float pitch_gain[3];
+   int pitch_half[2];
+   int i, sub, pitch, ol_pitch_id;
+   int best_pitch = 40;
+   float best_pitch_gain = 0;
+   float ol_pitch_coef, ol_gain;
+
+   /* No concealment, a lost frame plays as silence */
+   if (!bits)
+   {
+      SPEEX_MEMSET(out, 0, FRAME_SIZE);
+      return 0;
+   }
+   if (speex_bits_remaining(bits) < BITS_PER_FRAME)
+      return -1;
+
+   SPEEX_MOVE(st->excBuf, st->excBuf+FRAME_SIZE, DEC_HISTORY);
+
+   lsp_unquant_48k(qlsp, bits);
+   if (st->first)
+      SPEEX_COPY(st->old_qlsp, qlsp, ORDER);
+
+   pitch_half[0] = PITCH_START+speex_bits_unpack_unsigned(bits, 7);
+   pitch_half[1] = pitch_half[0]+speex_bits_unpack_unsigned(bits, 2)-1;
+   ol_pitch_id = speex_bits_unpack_unsigned(bits, 3);
+   ol_pitch_coef = 0.13514*ol_pitch_id;
+   ol_gain = exp((speex_bits_unpack_unsigned(bits, 4)+2)/2.1);
+
+   for (sub=0;sub<NB_SUBFRAMES;sub++)
+   {
+      int offset = SUBFRAME_SIZE*sub;
+      float *e = exc+offset;
+      int ol_pitch = sub*2 < NB_SUBFRAMES ? pitch_half[0] : pitch_half[1];
+      float tmp;
+
+      pitch_unquant_3tap(e, exc32, ol_pitch, ol_pitch, ol_pitch_coef, &ltp_params_48k, SUBFRAME_SIZE,
+                         &pitch, pitch_gain, bits, stack, 0, offset, 0, ol_pitch_id);
+      /* Keeps crafted packets from driving the filters to NaN */
+      sanitize_values32(exc32, -32000, 32000, SUBFRAME_SIZE);
+      tmp = gain_3tap_to_1tap(pitch_gain);
+      if (tmp>best_pitch_gain)
+      {
+         best_pitch = pitch;
+         best_pitch_gain = tmp;
+      }
+
+      SPEEX_MEMSET(innov, 0, SUBFRAME_SIZE);
+      split_cb_shape_sign_unquant(innov, &split_cb_nb_48k, SUBFRAME_SIZE, bits, stack, &st->seed);
+      for (i=0;i<SUBFRAME_SIZE;i++)
+         e[i]=exc32[i]+ol_gain*innov[i];
+   }
+
+   if (st->enh_enabled)
+   {
+      /* multicomb works on blocks of 80 samples */
+      for (i=0;i<FRAME_SIZE;i+=80)
+         multicomb(exc-SUBFRAME_SIZE+i, out+i, st->interp_qlpc, ORDER, 80, best_pitch, 40, COMB_GAIN, stack);
+   } else {
+      SPEEX_COPY(out, exc-SUBFRAME_SIZE, FRAME_SIZE);
+   }
+
+   /* The output lags one sub-frame, so each one uses the filter of the sub-frame before */
+   for (sub=0;sub<NB_SUBFRAMES;sub++)
+   {
+      float *sp = out+SUBFRAME_SIZE*sub;
+      lsp_interpolate(st->old_qlsp, qlsp, interp_qlsp, ORDER, sub, NB_SUBFRAMES, LSP_MARGIN);
+      lsp_to_lpc(interp_qlsp, ak, ORDER, stack);
+      iir_mem16(sp, st->interp_qlpc, sp, SUBFRAME_SIZE, ORDER, st->mem_sp, stack);
+      SPEEX_COPY(st->interp_qlpc, ak, ORDER);
+   }
+
+   SPEEX_COPY(st->old_qlsp, qlsp, ORDER);
+   st->first = 0;
+   return 0;
+}
+
+static int dec48_ctl(void *state, int request, void *ptr)
+{
+   Dec48State *st = (Dec48State*)state;
+   switch (request)
+   {
+   case SPEEX_GET_FRAME_SIZE:
+      *(spx_int32_t*)ptr = FRAME_SIZE;
+      break;
+   case SPEEX_SET_ENH:
+      st->enh_enabled = *(spx_int32_t*)ptr;
+      break;
+   case SPEEX_SET_SAMPLING_RATE:
+      break;
+   case SPEEX_RESET_STATE:
+      dec48_reset(st);
+      break;
+   default:
+      speex_warning_int("Unknown nb_ctl request: ", request);
+      return -1;
+   }
+   return 0;
+}
+
+static int nb48k_mode_query(const void *mode, int request, void *ptr)
+{
+   switch (request)
+   {
+   case SPEEX_MODE_FRAME_SIZE:
+      *(int*)ptr = FRAME_SIZE;
+      break;
+   case SPEEX_SUBMODE_BITS_PER_FRAME:
+      *(int*)ptr = BITS_PER_FRAME;
+      break;
+   default:
+      speex_warning_int("Unknown nb_mode_query request: ", request);
+      return -1;
+   }
+   return 0;
+}
+
+EXPORT const SpeexMode speex_nb_48k_mode = {
+   NULL,
+   nb48k_mode_query,
+   "narrowband 4.8 kbps",
+   1000,
+   4,
+   enc48_init,
+   enc48_destroy,
+   enc48_encode,
+   dec48_init,
+   dec48_destroy,
+   dec48_decode,
+   enc48_ctl,
+   dec48_ctl,
+};
