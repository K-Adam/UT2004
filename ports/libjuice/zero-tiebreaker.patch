 	if(msg.error_code != STUN_ERROR_INTERNAL_VALIDATION_FAILED)
 		return -1;
 
+	uint8_t role_message[] = {
+	    0x00, 0x01, 0x00, 0x0c,
+	    0x21, 0x12, 0xa4, 0x42,
+	    0x00, 0x00, 0x00, 0x00,
+	    0x00, 0x00, 0x00, 0x00,
