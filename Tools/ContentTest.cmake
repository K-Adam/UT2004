# Packs a small game folder as a zip, lets content_test unpack it and checks that exactly the content came out unchanged.
file(REMOVE_RECURSE ${DIR})
string(REPEAT "Deflate has something to do with a repeated line.\n" 4000 Text)
file(WRITE ${DIR}/in/UT2004/Maps/a.ut2 "${Text}")
file(WRITE ${DIR}/in/UT2004/Textures/b.utx "b")
file(WRITE ${DIR}/in/UT2004/System/Core.u "must stay out")
execute_process(COMMAND ${CMAKE_COMMAND} -E tar cf ../game.zip --format=zip UT2004
  WORKING_DIRECTORY ${DIR}/in COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${TEST}" ${DIR}/game.zip ${DIR}/out RESULT_VARIABLE Result OUTPUT_VARIABLE Out ERROR_VARIABLE Out)
if(NOT Result EQUAL 0)
  message(FATAL_ERROR "content_test failed (${Result}):\n${Out}")
endif()
foreach(file Maps/a.ut2 Textures/b.utx)
  file(SHA256 ${DIR}/in/UT2004/${file} Want)
  file(SHA256 ${DIR}/out/${file} Got)
  if(NOT Want STREQUAL Got)
    message(FATAL_ERROR "${file} was unpacked with other content")
  endif()
endforeach()
file(GLOB Unpacked RELATIVE ${DIR}/out ${DIR}/out/*)
list(SORT Unpacked)
if(NOT "${Unpacked}" STREQUAL "Maps;Textures")
  message(FATAL_ERROR "Folders other than the content were unpacked: ${Unpacked}")
endif()
