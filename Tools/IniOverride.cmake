# ut_ini_override(<var> <overrides>) rewrites the ini text in <var> with an ini fragment.
# Each key of the fragment replaces every line of that key in its section, so a list is given in full.
# Missing keys and sections are added. Nothing is removed, as the game fills keys an ini lacks from the defaults.
function(ut_ini_override var overrides)
  set(ini "${${var}}")
  # CMake lists split at ";" and do not split inside brackets.
  foreach(v overrides ini)
    string(REPLACE "[" "<lb>" ${v} "${${v}}")
    string(REPLACE "]" "<rb>" ${v} "${${v}}")
    string(REPLACE ";" "<sc>" ${v} "${${v}}")
    string(REPLACE "\r" "" ${v} "${${v}}")
    string(REPLACE "\n" ";" ${v} "${${v}}")
  endforeach()

  # Unreal matches sections and keys without regard to case, so they are compared in lowercase.
  set(sections "")
  set(section "")
  foreach(line IN LISTS overrides)
    if(line STREQUAL "" OR line MATCHES "^<sc>")
      continue()
    endif()
    if(line MATCHES "^<lb>(.*)<rb>$")
      list(APPEND sections "${CMAKE_MATCH_1}")
      string(TOLOWER "${CMAKE_MATCH_1}" section)
      string(MAKE_C_IDENTIFIER "${section}" section)
      continue()
    endif()
    string(REGEX MATCH "^[^=]+" key "${line}")
    string(TOLOWER "${key}" key)
    string(MAKE_C_IDENTIFIER "${key}" id)
    if(NOT key IN_LIST keys_${section})
      list(APPEND keys_${section} "${key}")
      set(lines_${section}_${id} "")
    endif()
    list(APPEND lines_${section}_${id} "${line}")
  endforeach()

  set(out "")
  set(section "")
  set(seen "")
  set(done "")
  foreach(line IN LISTS ini ITEMS "<lb><end><rb>")
    if(line MATCHES "^<lb>(.*)<rb>$")
      # Keys the section lacked go at its end.
      foreach(key IN LISTS keys_${section})
        if(NOT key IN_LIST done)
          string(MAKE_C_IDENTIFIER "${key}" id)
          list(APPEND out ${lines_${section}_${id}})
        endif()
      endforeach()
      if(line STREQUAL "<lb><end><rb>")
        break()
      endif()
      string(TOLOWER "${CMAKE_MATCH_1}" section)
      string(MAKE_C_IDENTIFIER "${section}" section)
      list(APPEND seen ${section})
      set(done "")
    else()
      string(REGEX MATCH "^[^=]+" key "${line}")
      string(TOLOWER "${key}" key)
      if(line MATCHES "=" AND key IN_LIST keys_${section})
        if(NOT key IN_LIST done)
          list(APPEND done "${key}")
          string(MAKE_C_IDENTIFIER "${key}" id)
          list(APPEND out ${lines_${section}_${id}})
        endif()
        continue()
      endif()
    endif()
    list(APPEND out "${line}")
  endforeach()
  foreach(name IN LISTS sections)
    string(TOLOWER "${name}" section)
    string(MAKE_C_IDENTIFIER "${section}" section)
    if(NOT section IN_LIST seen)
      list(APPEND out "" "<lb>${name}<rb>")
      foreach(key IN LISTS keys_${section})
        string(MAKE_C_IDENTIFIER "${key}" id)
        list(APPEND out ${lines_${section}_${id}})
      endforeach()
    endif()
  endforeach()

  string(REPLACE ";" "\n" out "${out}")
  string(REPLACE "<sc>" ";" out "${out}")
  string(REPLACE "<lb>" "[" out "${out}")
  string(REPLACE "<rb>" "]" out "${out}")
  set(${var} "${out}" PARENT_SCOPE)
endfunction()

# ut_ini_write(<out> <ini> <overrides>...) writes <ini> with each override file applied in turn.
function(ut_ini_write out ini)
  file(READ ${ini} text)
  foreach(file ${ARGN})
    file(READ ${file} overrides)
    ut_ini_override(text "${overrides}")
  endforeach()
  file(WRITE ${out} "${text}")
endfunction()
