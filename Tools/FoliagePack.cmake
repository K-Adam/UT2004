# Checks that Foliage/foliage.ini only names files and sections that exist and that each mesh file is whole.
# cmake -DDIR=<Foliage folder> -P FoliagePack.cmake
cmake_minimum_required(VERSION 3.26)
file(STRINGS ${DIR}/foliage.ini lines)
set(section "")
set(materials "")
set(meshes "")
set(sets "")
set(barks "")
set(trunks "")
set(count 0)
foreach(line IN LISTS lines)
  if(line MATCHES "^\\[(.+)\\]$")
    set(section ${CMAKE_MATCH_1})
    if(section MATCHES "^Material\\.(.+)$")
      list(APPEND materials ${CMAKE_MATCH_1})
    elseif(section MATCHES "^Mesh\\.(.+)$")
      list(APPEND meshes ${CMAKE_MATCH_1})
    elseif(section MATCHES "^Set\\.(.+)$")
      list(APPEND sets ${CMAKE_MATCH_1})
    elseif(section MATCHES "^Bark\\.(.+)$")
      list(APPEND barks ${CMAKE_MATCH_1})
    elseif(section MATCHES "^Trunk\\.(.+)$")
      list(APPEND trunks ${CMAKE_MATCH_1})
    endif()
  endif()
endforeach()

set(section "")
foreach(line IN LISTS lines)
  if(line MATCHES "^\\[(.+)\\]$")
    set(section ${CMAKE_MATCH_1})
  elseif(line MATCHES "^([^;=]+)=(.*)$")
    set(key ${CMAKE_MATCH_1})
    set(value ${CMAKE_MATCH_2})
    if(key STREQUAL "Albedo" OR key STREQUAL "Detail")
      if(NOT EXISTS ${DIR}/${value})
        message(FATAL_ERROR "${section}: ${value} is missing")
      endif()
      file(READ ${DIR}/${value} magic LIMIT 4 HEX)
      if(NOT magic STREQUAL "44445320")
        message(FATAL_ERROR "${value} is not a DDS file")
      endif()
    elseif(key MATCHES "^LOD[0-9]$")
      if(NOT EXISTS ${DIR}/${value})
        message(FATAL_ERROR "${section}: ${value} is missing")
      endif()
      # magic, version, vertex count and index count, little endian
      file(READ ${DIR}/${value} header LIMIT 16 HEX)
      string(SUBSTRING ${header} 0 8 magic)
      if(NOT magic STREQUAL "5048464d")
        message(FATAL_ERROR "${value} is not a foliage mesh")
      endif()
      foreach(field vertices indices)
        if(field STREQUAL "vertices")
          set(at 16)
        else()
          set(at 24)
        endif()
        string(SUBSTRING ${header} ${at} 8 hex)
        string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1" hex ${hex})
        math(EXPR ${field} "${hex}")
      endforeach()
      file(SIZE ${DIR}/${value} size)
      math(EXPR expected "40 + ${vertices} * 36 + ${indices} * 2")
      if(NOT size EQUAL expected OR vertices GREATER 65535)
        message(FATAL_ERROR "${value} has ${size} bytes, its header asks for ${expected}")
      endif()
      math(EXPR count "${count} + 1")
    elseif(key STREQUAL "Material" AND NOT value IN_LIST materials)
      message(FATAL_ERROR "${section} names the unknown material ${value}")
    elseif(key STREQUAL "Variant")
      string(REGEX REPLACE ":.*$" "" value ${value})
      if(NOT value IN_LIST meshes)
        message(FATAL_ERROR "${section} names the unknown mesh ${value}")
      endif()
    elseif(section STREQUAL "Replace" AND NOT value IN_LIST sets)
      message(FATAL_ERROR "${key} names the unknown set ${value}")
    elseif(key STREQUAL "Bark" AND NOT value IN_LIST barks)
      message(FATAL_ERROR "${section} names the unknown bark ${value}")
    elseif(section STREQUAL "Trunks" AND NOT value IN_LIST trunks)
      message(FATAL_ERROR "${key} names the unknown trunk ${value}")
    elseif(key STREQUAL "Mapping" AND NOT value STREQUAL "Stitch")
      message(FATAL_ERROR "${section} has the unknown mapping ${value}")
    elseif(key MATCHES "^(RepeatU|RepeatV|DetailScale)$" AND NOT value MATCHES "^[1-9][0-9]*$")
      # A bark that does not repeat a whole number of times breaks where the retail one wraps.
      message(FATAL_ERROR "${section}: ${key} has to be a whole number")
    endif()
  endif()
endforeach()
list(LENGTH sets num_sets)
if(count EQUAL 0 OR num_sets EQUAL 0)
  message(FATAL_ERROR "foliage.ini lists no meshes or sets")
endif()
message(STATUS "foliage pack: ${num_sets} sets, ${count} mesh files")
